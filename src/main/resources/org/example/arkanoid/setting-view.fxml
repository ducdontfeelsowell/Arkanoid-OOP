<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.effect.Glow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.arkanoid.controller.SettingController">
    <ImageView fitHeight="800.0" fitWidth="1280.0" pickOnBounds="true" preserveRatio="false">
        <image>
            <Image url="@../../../Images/background/menu_Background.jpg" />
        </image>
    </ImageView>
    <Label alignment="CENTER" layoutX="200.0" layoutY="85.0" prefHeight="234.0" prefWidth="880.0" text="Setting" textAlignment="RIGHT" textFill="#16ccf2" textOverrun="CLIP">
        <font>
            <Font name="Algerian" size="96.0" />
        </font>
        <effect>
            <Glow level="1.0" />
        </effect>
    </Label>

    <ImageView fx:id="backImage" fitHeight="105.0" fitWidth="133.0" layoutX="573.5" layoutY="702.0" pickOnBounds="true">
        <image>
            <Image url="@../../../Images/background/button1.png" />
        </image>
    </ImageView>
    <ImageView fx:id="backHoverImage" fitHeight="105.0" fitWidth="133.0" layoutX="573.5" layoutY="702.0" pickOnBounds="true" visible="false">
        <image>
            <Image url="@../../../Images/background/button.png" />
        </image>
    </ImageView>
    <Label alignment="CENTER" layoutX="580.5" layoutY="722.0" prefHeight="65.0" prefWidth="122.0" text="BACK" textFill="#4fcaf7">
        <font>
            <Font name="Calibri Bold Italic" size="25.0" />
        </font>
    </Label>
    <Button fx:id="backButton" layoutX="580.5" layoutY="722.0" mnemonicParsing="false" onAction="#onBackButton" opacity="0.0" prefHeight="65.0" prefWidth="122.0" text="Back">
        <opaqueInsets>
            <Insets />
        </opaqueInsets></Button>

    <CheckBox fx:id="muteCheckbox" layoutX="432.0" layoutY="289.0" mnemonicParsing="false" prefHeight="62.0" prefWidth="301.0" text="Âm Lượng" textFill="#fffdfd">
        <font>
            <Font size="42.0" />
        </font>
    </CheckBox>
    <ImageView fx:id="volumeIconViewHigh" fitHeight="74.0" fitWidth="81.0" layoutX="422.0" layoutY="362.0" pickOnBounds="true" preserveRatio="true">
        <image>
            <Image url="@../../../Images/maxVolume.png" />
        </image>
    </ImageView>
    <ImageView fx:id="volumeIconViewMuted" fitHeight="74.0" fitWidth="81.0" layoutX="422.0" layoutY="362.0" pickOnBounds="true" preserveRatio="true">
        <image>
            <Image url="@../../../Images/muted.png" />
        </image>
    </ImageView>
    <Slider fx:id="volumeSlider" layoutX="521.0" layoutY="392.0" max="1.0" value="0.5" />
    <Label layoutX="409.0" layoutY="423.0" prefHeight="68.0" prefWidth="204.0" text="Độ khó" textFill="WHITE">
        <font>
            <Font size="58.0" />
        </font>
    </Label>
    <Group layoutX="391.0" layoutY="522.0">
        <children>
            <HBox spacing="100.0">
                <children>
                    <RadioButton fx:id="easyRadio" mnemonicParsing="false" onAction="#onEasyClick" text="Dễ" textFill="#fcfcfc">
                        <font>
                            <Font size="23.0" />
                        </font>
                        <toggleGroup>
                            <ToggleGroup fx:id="difficultyToggleGroup" />
                        </toggleGroup>
                    </RadioButton>
                    <RadioButton fx:id="normalRadio" mnemonicParsing="false" onAction="#onNormalClick" selected="true" text="Bình thường" textFill="#fcfcfc" toggleGroup="$difficultyToggleGroup">
                        <font>
                            <Font size="23.0" />
                        </font>
                    </RadioButton>
                    <RadioButton fx:id="hardRadio" mnemonicParsing="false" onAction="#onHardClick" text="Khó" textFill="#fcfcfc" toggleGroup="$difficultyToggleGroup">
                        <font>
                            <Font size="23.0" />
                        </font>
                    </RadioButton>
                </children>
            </HBox>
        </children>
    </Group>
</AnchorPane>
