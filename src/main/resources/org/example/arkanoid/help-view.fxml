<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.effect.Glow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.arkanoid.controller.HelpController">
   <ImageView fitHeight="800.0" fitWidth="1280.0" pickOnBounds="true" preserveRatio="false">
      <image>
         <Image url="@../../../Images/background/menu_Background.jpg" />
      </image>
   </ImageView>
   <Label alignment="CENTER" contentDisplay="CENTER" layoutX="439.0" layoutY="108.0" prefHeight="142.0" prefWidth="371.0" text="HELP" textFill="#00f6ff">
      <font>
         <Font name="Algerian" size="96.0" />
      </font>
      <effect>
         <Glow level="1.0" />
      </effect>
   </Label>
   <ImageView fx:id="backImage" fitHeight="42.0" fitWidth="116.0" layoutX="593.0" layoutY="735.0" pickOnBounds="true" preserveRatio="false">
      <image>
         <Image url="@../../../Images/background/unnamed.png" />
      </image>
   </ImageView>
   <ImageView fx:id="backHoverImage" fitHeight="42.0" fitWidth="116.0" layoutX="593.0" layoutY="735.0" pickOnBounds="true" preserveRatio="true" visible="false">
      <image>
         <Image url="@../../../Images/background/unname2.png" />
      </image>
   </ImageView>
   <Label alignment="CENTER" layoutX="593.0" layoutY="734.0" prefHeight="42.0" prefWidth="116.0" text="BACK" textFill="WHITE">
      <font>
         <Font name="System Bold Italic" size="25.0" />
      </font>
   </Label>
    <Button fx:id="backButton" layoutX="593.0" layoutY="735.0" mnemonicParsing="false" onAction="#onBackButtonClick" opacity="0.0" prefHeight="42.0" prefWidth="116.0" text="Back" />
   <TextArea layoutX="167.0" layoutY="262.0" prefHeight="430.0" prefWidth="991.0" text="🎯 Mục tiêu&#10;Dùng thanh trượt (Paddle) để điều khiển quả bóng. Phá hủy tất cả các viên gạch có thể phá được trên màn hình để chiến thắng.&#10;&#10;Đừng để bóng rơi xuống cạnh dưới màn hình, nếu không bạn sẽ mất một mạng!&#10;&#10;🕹️ Điều khiển&#10;Phím Mũi tên Trái / Phải: Di chuyển thanh trượt.&#10;&#10;Phím Space (Dấu cách):&#10;&#10;Thả bóng ra để bắt đầu lượt chơi.&#10;&#10;Bắn đạn khi bạn đang có item &quot;Súng Bắn&quot; (Shooter Paddle).&#10;&#10;Phím Escape (ESC): Tạm dừng (Pause) hoặc tiếp tục (Resume) trò chơi.&#10;&#10;🎁 Vật phẩm (Items)&#10;Khi phá gạch, bạn có cơ hội nhận được các vật phẩm. Hãy dùng thanh trượt để đỡ chúng:&#10;&#10;Mở Rộng (Expand): Làm thanh trượt dài ra, giúp bạn đỡ bóng dễ hơn.&#10;&#10;Thu Nhỏ (Shrink): Làm thanh trượt ngắn lại (Cẩn thận!).&#10;&#10;Thêm Mạng (Extra Life): Tặng bạn thêm 1 mạng sống.&#10;&#10;Súng Bắn (Shooter): Gắn hai khẩu súng lên thanh trượt. Nhấn Space để bắn đạn và phá gạch từ bên dưới!&#10;&#10;🧱 Các loại Gạch&#10;Gạch Thường: Bị phá hủy sau 1 lần va chạm.&#10;&#10;Gạch Cứng: Cần 3 lần va chạm để phá hủy (máu của gạch sẽ hiển thị trên viên gạch).&#10;&#10;Gạch Bất Tử: Không thể bị phá hủy.&#10;&#10;Gạch Nổ (Explode): Khi bị phá hủy, nó sẽ phá hủy tất cả các gạch khác xung quanh nó (trừ gạch bất tử)." />
</AnchorPane>
