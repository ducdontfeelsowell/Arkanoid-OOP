<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.arkanoid.controller.GameController">
    <AnchorPane fx:id="pauseScreen" layoutX="200.0" layoutY="79.0" prefHeight="200.0" prefWidth="200.0" visible="false">
        <Button fx:id="resumeGameButton" layoutX="54.0" layoutY="29.0" mnemonicParsing="false"
                onAction="#onResumeGameClick" text="Resume game"/>
        <Button fx:id="backToMenuButton" layoutX="56.0" layoutY="147.0" mnemonicParsing="false"
                onAction="#onBackToMenuClick" text="Back to Menu"/>
    </AnchorPane>
</AnchorPane>
