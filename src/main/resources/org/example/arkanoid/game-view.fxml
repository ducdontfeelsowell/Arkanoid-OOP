<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.media.MediaView?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.arkanoid.controller.GameController">
   <AnchorPane fx:id="pauseScreen" layoutX="537.5" layoutY="343.5" prefHeight="141.0" prefWidth="185.0" visible="false">
      <children>
           <Button fx:id="resumeGameButton" layoutX="62.0" layoutY="34.0" mnemonicParsing="false" onAction="#onResumeClick" text="RESUME" visible="false" />
           <Button fx:id="backButton1" layoutX="62.0" layoutY="86.0" mnemonicParsing="false" onAction="#onBackClick1" prefHeight="26.0" prefWidth="61.0" text="BACK" />
      </children>
   </AnchorPane>
   <AnchorPane fx:id="loseScreen" prefHeight="141.0" prefWidth="185.0" visible="false">
      <children>
         <MediaView fx:id="lose_backgroundMediaView" fitHeight="800.0" fitWidth="1260.0" preserveRatio="false" />
         <Label alignment="CENTER" layoutX="349.0" layoutY="160.0" prefHeight="166.0" prefWidth="562.0" text="GAME OVER">
            <textFill>
               <LinearGradient endX="0.018939396197145637" endY="1.0">
                  <stops>
                     <Stop>
                        <color>
                           <Color />
                        </color>
                     </Stop>
                     <Stop offset="1.0">
                        <color>
                           <Color red="1.0" green="1.0" blue="1.0" />
                        </color>
                     </Stop>
                  </stops>
               </LinearGradient>
            </textFill>
            <font>
               <Font name="System Bold" size="96.0" />
            </font>
         </Label>
           <Button fx:id="playAgainButton" layoutX="588.8" layoutY="370.0" mnemonicParsing="false" onAction="#onPLayAgainClick" text="PLAY AGAIN" />
           <Button fx:id="backButton2" layoutX="588.8" layoutY="420.0" mnemonicParsing="false" onAction="#onBackClick2" prefHeight="26.0" prefWidth="86.0" text="BACK" />
      </children>
   </AnchorPane>
   <AnchorPane fx:id="winScreen" prefHeight="800.0" prefWidth="1260.0" visible="false">
      <children>
         <MediaView fx:id="win_backgroundMediaView" fitHeight="800.0" fitWidth="1260.0" preserveRatio="false" />
         <Button fx:id="backButton3" layoutX="200.0" layoutY="500.0" mnemonicParsing="false" onAction="#onBackClick3" prefHeight="70.0" prefWidth="152.0" text="BACK" />
      </children>
   </AnchorPane>
</AnchorPane>
