<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.arkanoid.controller.GameController">
   <AnchorPane fx:id="pauseScreen" layoutX="537.5" layoutY="343.5" prefHeight="141.0" prefWidth="185.0" visible="false">
      <children>
           <Button fx:id="resumeGameButton" layoutX="62.0" layoutY="34.0" mnemonicParsing="false" onAction="#onResumeClick" text="RESUME" visible="false" />
           <Button fx:id="backButton1" layoutX="62.0" layoutY="86.0" mnemonicParsing="false" onAction="#onBackClick1" prefHeight="26.0" prefWidth="61.0" text="BACK" />
      </children>
   </AnchorPane>
   <AnchorPane fx:id="loseScreen" layoutX="537.5" layoutY="343.5" prefHeight="141.0" prefWidth="185.0" visible="false">
      <children>
           <Button fx:id="playAgainButton" layoutX="51.0" layoutY="28.0" mnemonicParsing="false" onAction="#onPLayAgainClick" text="PLAY AGAIN" />
           <Button fx:id="backButton2" layoutX="49.0" layoutY="82.0" mnemonicParsing="false" onAction="#onBackClick2" prefHeight="26.0" prefWidth="86.0" text="BACK" />
      </children>
   </AnchorPane>
   <AnchorPane fx:id="winScreen" layoutX="537.5" layoutY="343.5" prefHeight="141.0" prefWidth="185.0" visible="false">
      <children>
         <Button fx:id="backButton3" layoutX="49.0" layoutY="57.0" mnemonicParsing="false" onAction="#onBackClick3" prefHeight="26.0" prefWidth="86.0" text="BACK" />
      </children>
   </AnchorPane>
</AnchorPane>
