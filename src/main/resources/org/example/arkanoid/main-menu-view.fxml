<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Rectangle2D?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.Glow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1280.0"
            stylesheets="@../../../../java/org/example/arkanoid/scene.css" xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.arkanoid.controller.MenuController">
    <children>
        <ImageView fitHeight="800.0" fitWidth="1280.0" pickOnBounds="true" AnchorPane.topAnchor="0.0">
            <image>
                <Image url="@../../../Images/background/menu_Background.jpg"/>
            </image>
            <viewport>
                <Rectangle2D width="800.0"/>
            </viewport>
        </ImageView>

        <Label alignment="CENTER" contentDisplay="CENTER" layoutX="308.0" layoutY="97.0" prefHeight="222.0"
               prefWidth="665.0" text="ARKANOID" textFill="#08e7e3">
            <font>
                <Font name="Algerian" size="120.0"/>
            </font>
            <effect>
                <Glow level="1.0"/>
            </effect>
            <cursor>
                <Cursor fx:constant="CROSSHAIR"/>
            </cursor>
        </Label>

        <ImageView fx:id="playImage" fitHeight="68.0" fitWidth="200.0" layoutX="545.0" layoutY="366.0"
                   pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../../../Images/background/unnamed.png"/>
            </image>
        </ImageView>
        <ImageView fx:id="playHoverImage" fitHeight="68.0" fitWidth="190.0" layoutX="545.0" layoutY="366.0"
                   mouseTransparent="true" pickOnBounds="true" preserveRatio="true" visible="false">
            <image>
                <Image url="@../../../Images/background/unname2.png"/>
            </image>
        </ImageView>
        <Label alignment="CENTER" layoutX="541.0" layoutY="366.0" prefHeight="68.0" prefWidth="200.0" text="PLAY"
               textFill="WHITE">
            <font>
                <Font name="System Bold Italic" size="40.0"/>
            </font>
        </Label>
        <Button fx:id="playButton" layoutX="544.0" layoutY="366.0" mnemonicParsing="false"
                onAction="#onPlayGameButtonClick" opacity="0.0" prefHeight="67.0" prefWidth="190.0"
                stylesheets="@../../../../java/org/example/arkanoid/scene.css" text="Play Game"/>

        <ImageView fx:id="helpImage" fitHeight="46.0" fitWidth="135.0" layoutX="394.0" layoutY="567.0"
                   pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../../../Images/background/unnamed.png"/>
            </image>
        </ImageView>
        <ImageView fx:id="helpHoverImage" fitHeight="58.0" fitWidth="135.0" layoutX="394.0" layoutY="566.0"
                   mouseTransparent="true" pickOnBounds="true" preserveRatio="true" visible="false">
            <image>
                <Image url="@../../../Images/background/unname2.png"/>
            </image>
        </ImageView>
        <Label alignment="CENTER" layoutX="391.0" layoutY="568.0" prefHeight="45.0" prefWidth="135.0" text="HELP"
               textFill="#fcfcfc">
            <font>
                <Font name="System Bold Italic" size="25.0"/>
            </font>
        </Label>
        <Button fx:id="helpButton" layoutX="394.0" layoutY="566.0" mnemonicParsing="false" onAction="#onHelpButtonClick"
                opacity="0.0" prefHeight="47.0" prefWidth="130.0" text="Help"/>

        <ImageView fx:id="settingImage" fitHeight="46.0" fitWidth="135.0" layoutX="572.0" layoutY="567.0"
                   pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../../../Images/background/unnamed.png"/>
            </image>
        </ImageView>
        <ImageView fx:id="settingHoverImage" fitHeight="63.0" fitWidth="135.0" layoutX="572.0" layoutY="566.0"
                   mouseTransparent="true" pickOnBounds="true" preserveRatio="true" visible="false">
            <image>
                <Image url="@../../../Images/background/unname2.png"/>
            </image>
        </ImageView>
        <Label alignment="CENTER" layoutX="570.0" layoutY="568.0" prefHeight="45.0" prefWidth="135.0" text="SETTING"
               textFill="#fcfcfc">
            <font>
                <Font name="System Bold Italic" size="25.0"/>
            </font>
        </Label>
        <Button fx:id="settingButton" layoutX="574.0" layoutY="565.0" mnemonicParsing="false"
                onAction="#onSettingButtonClick" opacity="0.0" prefHeight="47.0" prefWidth="130.0" text="Setting"/>

        <ImageView fx:id="shopImage" fitHeight="46.0" fitWidth="135.0" layoutX="754.0" layoutY="568.0"
                   pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../../../Images/background/unnamed.png"/>
            </image>
        </ImageView>
        <ImageView fx:id="shopHoverImage" fitHeight="46.0" fitWidth="135.0" layoutX="754.0" layoutY="567.0"
                   mouseTransparent="true" pickOnBounds="true" preserveRatio="true" visible="false">
            <image>
                <Image url="@../../../Images/background/unname2.png"/>
            </image>
        </ImageView>
        <Label alignment="CENTER" layoutX="752.0" layoutY="569.0" prefHeight="45.0" prefWidth="135.0" text="SHOP"
               textFill="#fcfcfc">
            <font>
                <Font name="System Bold Italic" size="25.0"/>
            </font>
        </Label>
        <Button fx:id="shopButton" layoutX="754.0" layoutY="567.0" mnemonicParsing="false" onAction="#onShopButtonClick"
                opacity="0.0" prefHeight="47.0" prefWidth="130.0" text="SHOP"/>
        <ImageView fx:id="exitImage" fitHeight="46.0" fitWidth="128.0" layoutX="170.0" layoutY="642.0"
                   pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../../../Images/background/unnamed.png"/>
            </image>
        </ImageView>
        <ImageView fx:id="exitHoverImage" fitHeight="46.0" fitWidth="128.0" layoutX="170.0" layoutY="642.0"
                   pickOnBounds="true" preserveRatio="true" visible="false">
            <image>
                <Image url="@../../../Images/background/unname2.png"/>
            </image>
        </ImageView>
        <Label alignment="CENTER" layoutX="170.0" layoutY="643.0" prefHeight="46.0" prefWidth="128.0" text="EXIT"
               textFill="WHITE">
            <font>
                <Font name="System Bold Italic" size="25.0"/>
            </font>
        </Label>

        <Button fx:id="exitButton" layoutX="170.0" layoutY="642.0" mnemonicParsing="false"
                onAction="#onExitGameButtonClick" opacity="0.0" prefHeight="46.0" prefWidth="128.0"/>
    </children>
</AnchorPane>
