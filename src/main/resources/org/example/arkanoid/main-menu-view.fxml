<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="436.0" prefWidth="710.0" spacing="20.0" xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.arkanoid.controller.MenuController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Button fx:id="playButton" mnemonicParsing="false" onAction="#onPlayGameButtonClick" text="Play game"/>
    <Button fx:id="helpButton" mnemonicParsing="false" onAction="#onHelpButtonClick" text="Help"/>
    <Button fx:id="settingButton" mnemonicParsing="false" onAction="#onSettingButtonClick" text="Setting"/>
    <Button fx:id="exitButton" mnemonicParsing="false" onAction="#onExitGameButtonClick" text="Exit game"/>
</VBox>
